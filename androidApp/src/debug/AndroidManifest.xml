        <activity android:name=".AudioProbeActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />
        <activity android:name=".GamepadProbeActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />
        <activity android:name=".Pc1350SkinProbeActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />
        <activity android:name=".PlayerInputProbeActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
