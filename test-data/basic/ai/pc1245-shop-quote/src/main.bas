10 REM SHOP QUOTE
20 REM 1 RETAIL, 2 PACK
30 INPUT "MODE";M
40 IF M=1 THEN 100
50 IF M=2 THEN 200
60 GOTO 30
100 REM RETAIL QUOTE
110 INPUT "PRICE";P
120 IF P<0 THEN 110
130 GOSUB 500
140 PRINT "RETAIL";T
150 END
200 REM PACK QUOTE
210 INPUT "PRICE";P
220 IF P<0 THEN 210
230 INPUT "QTY";Q
240 IF Q<1 THEN 230
250 GOSUB 600
260 PRINT "PACK";T
270 END
500 REM RETAIL SURCHARGE
510 R=5
520 T=P+P*R/100
530 RETURN
600 REM PACK DISCOUNT
610 D=10
620 S=P*Q
630 T=S-S*D/100
640 RETURN
